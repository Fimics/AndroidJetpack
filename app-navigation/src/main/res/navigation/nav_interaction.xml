<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_interaction"
    app:startDestination="@id/interactionHomeFragment">

    <fragment
        android:id="@+id/interactionHomeFragment"
        android:name="com.noetix.robotics.demo.interaction.fragments.InteractionHomeFragment"
        android:label="实时互动 - 首页"
        tools:layout="@layout/fragment_demo">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/interactionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/interactionDetailFragment"
        android:name="com.noetix.robotics.demo.interaction.fragments.InteractionDetailFragment"
        android:label="实时互动 - 详情页"
        tools:layout="@layout/fragment_demo" />

</navigation>
