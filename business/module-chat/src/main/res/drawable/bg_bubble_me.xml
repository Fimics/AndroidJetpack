<?xml version="1.0" encoding="utf-8"?>
<!-- 我的气泡：圆角矩形，右上角小圆角(贴边方向)，内置 padding。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chat_bubble_me" />
    <corners
        android:radius="16dp"
        android:topRightRadius="4dp" />
    <padding
        android:left="14dp"
        android:top="10dp"
        android:right="14dp"
        android:bottom="10dp" />
</shape>