<?xml version="1.0" encoding="utf-8"?>
<!-- 对方气泡：圆角矩形，左上角小圆角(贴边方向)，浅色下加淡描边以与背景区分。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chat_bubble_other" />
    <corners
        android:radius="16dp"
        android:topLeftRadius="4dp" />
    <stroke
        android:width="0.5dp"
        android:color="@color/chat_bubble_stroke" />
    <padding
        android:left="14dp"
        android:top="10dp"
        android:right="14dp"
        android:bottom="10dp" />
</shape>