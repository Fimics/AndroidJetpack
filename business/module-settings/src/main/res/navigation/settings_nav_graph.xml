<?xml version="1.0" encoding="utf-8"?>
<!-- 设置业务子图：由 app 的 nav_graph_main 通过 <include> 汇总（见 §5.10）。 -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_nav_graph"
    app:startDestination="@id/settingsFragment">

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.mic.guide.module.settings.ui.SettingsFragment"
        android:label="Settings">
        <action
            android:id="@+id/action_settings_to_detail"
            app:destination="@id/settingsDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsDetailFragment"
        android:name="com.mic.guide.module.settings.ui.SettingsDetailFragment"
        android:label="SettingsDetail">
        <argument
            android:name="sectionKey"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="sectionTitle"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

</navigation>